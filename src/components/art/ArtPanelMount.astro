<aside class="art-panel" data-art-panel aria-hidden="true">
  <div class="art-surface" data-art-surface>
    <canvas class="art-canvas" data-art-canvas></canvas>
    <div class="art-fallback"></div>
    <p class="art-caption">an evolving tessellation</p>
  </div>
</aside>

<script>
  import '../art/ArtPanelMount.ts';
</script>

<style>
  .art-panel {
    position: relative;
  }

  .art-surface {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-bg-raised);
    border: 1px solid var(--color-border);
  }

  .art-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .art-fallback {
    position: absolute;
    inset: 0;
    display: none;
    background:
      radial-gradient(circle at 20% 30%, var(--color-terracotta) 0%, transparent 45%),
      radial-gradient(circle at 78% 22%, var(--color-clay) 0%, transparent 50%),
      radial-gradient(circle at 60% 78%, var(--color-sage) 0%, transparent 50%),
      radial-gradient(circle at 12% 82%, var(--color-slate) 0%, transparent 45%),
      var(--color-bg-raised);
  }

  .art-caption {
    position: absolute;
    left: var(--space-3);
    bottom: var(--space-3);
    margin: 0;
    font-size: var(--text-xs);
    font-style: italic;
    color: var(--color-text-muted);
    background: rgba(251, 248, 242, 0.75);
    padding: 0.2em 0.6em;
    border-radius: var(--radius-sm);
  }

  @media (min-width: 1024px) {
    .art-panel {
      position: sticky;
      top: var(--space-5);
      align-self: start;
      padding-top: 19vh;
      height: calc(100vh - var(--space-5) * 2);
      max-height: 640px;
    }
  }

  @media (max-width: 1023.98px) {
    .art-panel {
      order: -1;
    }

    .art-surface {
      aspect-ratio: 21 / 9;
    }
  }

  @media (max-width: 639.98px) {
    .art-canvas {
      display: none;
    }

    .art-fallback {
      display: block;
    }
  }
</style>
