---
import Bio from '../sections/Bio.astro';
import PublicationsList from '../sections/PublicationsList.astro';
import Hobbies from '../sections/Hobbies.astro';
---

<main class="main-column content-width">
  <div class="stack">
    <div class="hero">
      <div class="intro-block">
        <Bio />
      </div>
    </div>
    <PublicationsList />
    <Hobbies />
  </div>
</main>

<style>
  .hero {
    padding-top: 19vh;
  }

  .intro-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  @media (max-width: 1023.98px) {
    .hero {
      padding-top: 4vh;
    }
  }
</style>
