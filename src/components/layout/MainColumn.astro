---
import Bio from '../sections/Bio.astro';
import ContactInfo from '../sections/ContactInfo.astro';
import PublicationsList from '../sections/PublicationsList.astro';
import ProjectsGrid from '../sections/ProjectsGrid.astro';
import ExperienceTimeline from '../sections/ExperienceTimeline.astro';
import BlogList from '../sections/BlogList.astro';
import Hobbies from '../sections/Hobbies.astro';
---

<main class="main-column content-width">
  <div class="stack">
    <div class="intro-block">
      <Bio />
      <ContactInfo />
    </div>
    <PublicationsList />
    <ProjectsGrid />
    <ExperienceTimeline />
    <BlogList limit={3} />
    <Hobbies />
  </div>
</main>

<style>
  .intro-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
</style>
