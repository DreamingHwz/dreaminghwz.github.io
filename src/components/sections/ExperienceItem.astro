---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'experience'>['data'];
}

const { entry } = Astro.props;
const { org, title, location, startDate, endDate, description, highlights } = entry;

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
}

const dateRange = `${formatDate(startDate)} – ${endDate ? formatDate(endDate) : 'Present'}`;
---

<article class="entry">
  <div class="entry-head">
    <div>
      <h3>{title}</h3>
      <p class="org">{org}{location ? ` · ${location}` : ''}</p>
    </div>
    <p class="dates">{dateRange}</p>
  </div>
  {description && <p class="description">{description}</p>}
  {
    highlights.length > 0 && (
      <ul class="highlights">
        {highlights.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .entry {
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .entry:last-child {
    border-bottom: none;
  }

  .entry-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  h3 {
    margin: 0;
    font-size: var(--text-base);
  }

  .org {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .dates {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  .description {
    font-size: var(--text-sm);
    margin: var(--space-2) 0 0;
  }

  .highlights {
    font-size: var(--text-sm);
    margin: var(--space-1) 0 0;
    color: var(--color-text-muted);
  }
</style>
