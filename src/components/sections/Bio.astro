---
import { site } from '../../data/site';
import ContactInfo from './ContactInfo.astro';
---

<section class="bio" aria-label="Introduction">
  <div class="portrait blob-frame">
    <img src={site.profileImage} alt={`Portrait of ${site.name}`} width="140" height="140" />
  </div>
  <div class="intro">
    <div class="name-row">
      <h1>{site.name}</h1>
      <ContactInfo />
    </div>
    <p class="role" set:html={site.role} />
    <p class="bio-text" set:html={site.bio} />
  </div>
</section>

<style>
  .bio {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
  }

  .portrait {
    flex-shrink: 0;
    width: 130px;
    height: 130px;
    background: var(--color-bg-raised);
    border: 1px solid var(--color-border);
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0%;
  }

  .intro {
    min-width: 0;
    flex: 1;
  }

  .name-row {
    display: flex;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-2);
  }

  .name-row :global(.contact-list) {
    margin-bottom: 0.5em;
  }

  h1 {
    margin-bottom: 0;
  }

  .role {
    color: var(--color-text-muted);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }

  .bio-text {
    margin-bottom: 0;
    max-width: 60ch;
  }
</style>
