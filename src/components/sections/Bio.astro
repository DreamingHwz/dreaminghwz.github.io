---
import { site } from '../../data/site';
---

<section class="bio" aria-label="Introduction">
  <div class="portrait blob-frame">
    <img src={site.profileImage} alt={`Portrait of ${site.name}`} width="128" height="128" />
  </div>
  <div class="intro">
    <h1>{site.name}</h1>
    <p class="role">{site.role}</p>
    <p class="bio-text">{site.bio}</p>
  </div>
</section>

<style>
  .bio {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
  }

  .portrait {
    flex-shrink: 0;
    width: 96px;
    height: 96px;
    background: var(--color-bg-raised);
    border: 1px solid var(--color-border);
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .intro {
    min-width: 0;
    flex: 1;
  }

  h1 {
    margin-bottom: var(--space-1);
  }

  .role {
    color: var(--color-text-muted);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }

  .bio-text {
    margin-bottom: 0;
    max-width: 60ch;
  }
</style>
