---
import SectionHeading from '../ui/SectionHeading.astro';
import Playlist from './Playlist.astro';
import PhotoGallery from './PhotoGallery.astro';
---

<section aria-labelledby="hobbies-heading">
  <SectionHeading title="Hobbies" id="hobbies-heading" />
  <div class="hobbies">
    <div>
      <h3>Playlist</h3>
      <Playlist />
    </div>
    <div>
      <h3>Photos</h3>
      <PhotoGallery />
    </div>
  </div>
</section>

<style>
  .hobbies {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  h3 {
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }
</style>
