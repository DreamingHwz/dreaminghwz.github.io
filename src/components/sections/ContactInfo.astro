---
import { site } from '../../data/site';
import SocialIcon from '../ui/SocialIcon.astro';
---

<section aria-label="Contact">
  <ul class="contact-list">
    <li>
      <a href={`mailto:${site.email}`} aria-label={`Email ${site.name}`} title="Email">
        <SocialIcon name="email" />
      </a>
    </li>
    {
      site.socials.map((social) => (
        <li>
          <a href={social.url} target="_blank" rel="noopener noreferrer" aria-label={social.label} title={social.label}>
            <SocialIcon name={social.icon} />
          </a>
        </li>
      ))
    }
    <li>
      <a href={site.cvUrl} aria-label="Download CV" title="CV (PDF)">
        <SocialIcon name="cv" />
      </a>
    </li>
  </ul>
</section>

<style>
  .contact-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
  }

  .contact-list a {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #5f7048;
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .contact-list a:hover {
    color: var(--color-accent);
    transform: translateY(-1px);
  }

  .contact-list :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
  }
</style>
