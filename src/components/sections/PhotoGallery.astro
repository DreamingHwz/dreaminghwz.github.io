---
import { Image } from 'astro:assets';

const photos = Object.values(
  import.meta.glob('/src/assets/gallery/*.{png,jpg,jpeg,webp}', { eager: true })
) as { default: ImageMetadata }[];
---

<div class="gallery">
  {
    photos.length === 0 ? (
      <p class="empty">No photos yet — drop images into src/assets/gallery/.</p>
    ) : (
      photos.map(({ default: photo }) => (
        <div class="frame">
          <Image src={photo} alt="" width={320} height={240} loading="lazy" />
        </div>
      ))
    )
  }
</div>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: var(--space-3);
  }

  .frame {
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--color-border);
  }

  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .empty {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
